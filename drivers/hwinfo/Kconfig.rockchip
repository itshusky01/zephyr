config HWINFO_RK3506
	bool "Rockchip RK3506 reset cause"
	default y
	depends on HWINFO
	depends on SOC_RK3506
	depends on DT_HAS_ROCKCHIP_RK3506_RESET_REASON_ENABLED
	select HWINFO_HAS_DRIVER
	help
	  Decode reset causes from the RK3506 PMU reset status register and,
	  when a board selects it in devicetree, an optional persistent scratch
	  marker maintained by the boot firmware.
